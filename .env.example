# Copy to .env if you adapt these scripts to run REMOTELY (not on the box).
# On-box usage needs no configuration — scripts use localhost JSON-RPC.

# KODI_HOST=127.0.0.1
# KODI_PORT=9090

# If you enable Kodi's webserver for HTTP control (the raw TCP 9090 socket
# used here needs no auth):
# KODI_USER=
# KODI_PASS=
